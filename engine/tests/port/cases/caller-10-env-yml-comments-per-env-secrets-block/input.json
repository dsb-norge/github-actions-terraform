{
  "caller": {
    "default_branch": "main",
    "repository": "example-org/example-repo"
  },
  "directories_exist": {
    "./envs/env-a": true
  },
  "event": {
    "name": "workflow_dispatch",
    "ref_name": "main"
  },
  "schema_version": 1,
  "workflow_inputs": {
    "add-pr-comment": true,
    "apply-extract-include-outputs": false,
    "cache-terraform-modules": true,
    "environments-yml": "# comment\n# comment\n# comment\n- environment: \"env-a\"\n  runs-on: \"runner-a\"\n  url: \"https://example.com/a\"\n  extra-envs-from-secrets-yml: |\n    TF_VAR_var_a: SECRET_D\n",
    "extra-envs-from-secrets-per-goal-yml": "{}",
    "extra-envs-from-secrets-yml": "ARM_TENANT_ID: SECRET_A\nARM_SUBSCRIPTION_ID: SECRET_B\nARM_CLIENT_ID: SECRET_C\n",
    "extra-envs-per-goal-yml": "{}",
    "extra-envs-yml": "ARM_USE_OIDC: true\nARM_USE_AZUREAD: true # comment\n",
    "format-check-in-root-dir": false,
    "goals-yml": "[all]",
    "path-relevance-enabled": true,
    "pr-auto-merge-app-id": "",
    "pr-auto-merge-app-private-key-secret": "",
    "pr-auto-merge-enabled": false,
    "pr-auto-merge-from-actors-yml": "[]",
    "pr-auto-merge-limits-yml": "plan-max-count-add: 0\nplan-max-count-change: 0\nplan-max-count-destroy: 0\nplan-max-count-import: -1\nplan-max-count-move: -1\nplan-max-count-remove: 0\n",
    "pr-comment-group": "",
    "runs-on": "ubuntu-latest",
    "terraform-init-additional-dirs-yml": "- \"./main\"\n- \"./modules/mod-a\"\n- \"./modules/mod-b\"\n- \"./modules/mod-c\"\n- \"./modules/mod-d\"\n- \"./modules/mod-e\"\n",
    "terraform-version": "1.15.x",
    "tflint-version": "v0.64.0",
    "verify-lock-file": true
  },
  "yaml": {
    "environments": [
      {
        "extra-envs-from-secrets-yml": {
          "ok": true,
          "value": {
            "TF_VAR_var_a": "SECRET_D"
          }
        }
      }
    ],
    "inputs": {
      "environments-yml": {
        "ok": true,
        "value": [
          {
            "environment": "env-a",
            "extra-envs-from-secrets-yml": "TF_VAR_var_a: SECRET_D\n",
            "runs-on": "runner-a",
            "url": "https://example.com/a"
          }
        ]
      },
      "extra-envs-from-secrets-per-goal-yml": {
        "ok": true,
        "value": {}
      },
      "extra-envs-from-secrets-yml": {
        "ok": true,
        "value": {
          "ARM_CLIENT_ID": "SECRET_C",
          "ARM_SUBSCRIPTION_ID": "SECRET_B",
          "ARM_TENANT_ID": "SECRET_A"
        }
      },
      "extra-envs-per-goal-yml": {
        "ok": true,
        "value": {}
      },
      "extra-envs-yml": {
        "ok": true,
        "value": {
          "ARM_USE_AZUREAD": true,
          "ARM_USE_OIDC": true
        }
      },
      "goals-yml": {
        "ok": true,
        "value": [
          "all"
        ]
      },
      "pr-auto-merge-from-actors-yml": {
        "ok": true,
        "value": []
      },
      "pr-auto-merge-limits-yml": {
        "ok": true,
        "value": {
          "plan-max-count-add": 0,
          "plan-max-count-change": 0,
          "plan-max-count-destroy": 0,
          "plan-max-count-import": -1,
          "plan-max-count-move": -1,
          "plan-max-count-remove": 0
        }
      },
      "terraform-init-additional-dirs-yml": {
        "ok": true,
        "value": [
          "./main",
          "./modules/mod-a",
          "./modules/mod-b",
          "./modules/mod-c",
          "./modules/mod-d",
          "./modules/mod-e"
        ]
      }
    }
  }
}
