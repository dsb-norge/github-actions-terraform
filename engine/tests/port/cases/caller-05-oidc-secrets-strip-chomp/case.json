{
  "description": "anonymised shape of real callers: oidc secrets strip chomp",
  "inputs_json": {
    "environments-yml": "- environment: \"env-a\"\n  runs-on: \"runner-a\"\n  url: \"https://example.com/a\"",
    "goals-yml": "[all]",
    "terraform-init-additional-dirs-yml": "- \"./main\"\n",
    "extra-envs-yml": "ARM_USE_OIDC: true\nARM_USE_AZUREAD: true # comment\n",
    "extra-envs-from-secrets-yml": "ARM_TENANT_ID: SECRET_A\nARM_SUBSCRIPTION_ID: SECRET_B\nARM_CLIENT_ID: SECRET_C\n",
    "extra-envs-per-goal-yml": "{}",
    "extra-envs-from-secrets-per-goal-yml": "{}",
    "terraform-version": "1.15.x",
    "tflint-version": "v0.63.1",
    "format-check-in-root-dir": false,
    "add-pr-comment": true,
    "verify-lock-file": true,
    "path-relevance-enabled": true,
    "terraform-test-enabled": true,
    "allow-failing-terraform-tests": false,
    "terraform-test-runs-on": "ubuntu-latest",
    "terraform-test-timeout-minutes": 30,
    "terraform-test-lanes-yml": "",
    "terraform-test-exclude-paths-yml": "",
    "cache-terraform-modules": true,
    "apply-extract-include-outputs": false,
    "pr-comment-group": "",
    "pr-auto-merge-enabled": false,
    "pr-auto-merge-from-actors-yml": "[]",
    "pr-auto-merge-limits-yml": "plan-max-count-add: 0\nplan-max-count-change: 0\nplan-max-count-destroy: 0\nplan-max-count-import: -1\nplan-max-count-move: -1\nplan-max-count-remove: 0\n",
    "pr-auto-merge-app-id": "",
    "pr-auto-merge-app-private-key-secret": "",
    "runs-on": "ubuntu-latest"
  },
  "ref_name": "main",
  "default_branch": "main",
  "directories": [
    "envs/env-a"
  ]
}
